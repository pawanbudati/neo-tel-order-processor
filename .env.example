# Kotak Neo API Credentials
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_TOTP_KEY=
KOTAK_MPIN=
KOTAK_ENVIRONMENT=prod

# Order Execution Parameters
DEFAULT_PRODUCT_TYPE=MIS
DEFAULT_LOTS=3
SL_LIMIT_BUFFER_PERCENT=1.0
AUTO_CANCEL_ON_REVISE=true
RISK_PERCENTAGE=
DEFAULT_CAPITAL=
ACTIVE_TRADES_PATH=runtime/active_trades.json

# Google Cloud Pub/Sub (Always Free Tier - 10 GB/month included free)
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_SIGNALS=kotak_trading_signals
# Unique subscription per account for native fanout (e.g., kotak_executor_yuva)
PUBSUB_SUBSCRIPTION_ID=kotak_executor_default
# Optional: Path to Service Account JSON key (leave empty if using ADC or GCP VM IAM role)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Optional local emulator for offline testing:
# PUBSUB_EMULATOR_HOST=localhost:8085

# Optional Telegram Push Alerts for Executed Trades & Order Status
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
