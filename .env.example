# Kotak Neo API Credentials
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_TOTP_KEY=
KOTAK_MPIN=
KOTAK_ENVIRONMENT=prod

# Order Execution Parameters
DEFAULT_PRODUCT_TYPE=MIS
DEFAULT_LOTS=3
SL_LIMIT_BUFFER_PERCENT=1.0
AUTO_CANCEL_ON_REVISE=true
RISK_PERCENTAGE=
DEFAULT_CAPITAL=
ACTIVE_TRADES_PATH=runtime/active_trades.json

# Account identifier (e.g., yuva, pavan, sahi, hari)
ACCOUNT_ID=yuva

# Google Cloud Pub/Sub (Always Free Tier - 10 GB/month included free)
GCP_PROJECT_ID=fourth-arena-460820-s6
PUBSUB_TOPIC_SIGNALS=kotak_trading_signals
# Unique subscription per account for native fanout (e.g., kotak_executor_yuva, kotak_executor_pavan, kotak_executor_sahi, kotak_executor_hari)
PUBSUB_SUBSCRIPTION_ID=kotak_executor_yuva
# Path to GCP Service Account JSON key (required if VM is in another GCP account or external)
GOOGLE_APPLICATION_CREDENTIALS=gcp-pubsub-key.json
# Optional local emulator for offline testing:
# PUBSUB_EMULATOR_HOST=localhost:8085

# Optional Telegram Push Alerts for Executed Trades & Order Status
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
