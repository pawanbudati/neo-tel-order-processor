# Deployment Configuration for Consumer
# Copy this file to .env.deploy in the consumer directory (it is git-ignored):
# cp deploy/.env.deploy.example .env.deploy

# Primary VM
GCP_VM_HOST=
GCP_VM_USER=
GCP_VM_SSH_KEY=~/.ssh/id_rsa
GCP_VM_SSH_PORT=22
CONSUMER_DEPLOY_PATH=

# Yuva VM (optional - if set, 'all' target deploys here as well)
GCP_VM_HOST_YUVA=
GCP_VM_USER_YUVA=
GCP_VM_SSH_KEY_YUVA=~/.ssh/id_rsa
GCP_VM_SSH_PORT_YUVA=22
CONSUMER_DEPLOY_PATH_YUVA=
