# Deployment Configuration for Consumer
# Copy this file to deploy.env or .env.deploy in the consumer directory (it is git-ignored):
# cp deploy/deploy.env.example deploy.env

# Shared SSH defaults
GCP_VM_USER=pawanbudati
GCP_VM_SSH_KEY=~/.ssh/id_rsa
GCP_VM_SSH_PORT=22
CONSUMER_DEPLOY_PATH=

# Primary VM
GCP_VM_HOST=

# Yuva VM
GCP_VM_HOST_YUVA=
